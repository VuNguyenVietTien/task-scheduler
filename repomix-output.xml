            Task,
            r#"
            SELECT * FROM tasks 
            WHERE task_id = $1 AND is_deleted = false
            "#,
            task_id
        )
        .fetch_optional(pool)
        .await
        .map_err(|e| Error::new(format!("Failed to fetch task: {}", e)))?;

