/* Styles for resizable images */
.resizableImage {
  position: relative;
  display: inline-block;
  max-width: 100%;
}

.resizableImage img {
  display: block;
}

.resizableImage .resizeHandle {
  position: absolute;
  width: 10px;
  height: 10px;
  background-color: #4299e1;
  border: 1px solid white;
  border-radius: 50%;
}

.resizableImage .resizeHandle.nw {
  top: -5px;
  left: -5px;
  cursor: nwse-resize;
}

.resizableImage .resizeHandle.ne {
  top: -5px;
  right: -5px;
  cursor: nesw-resize;
}

.resizableImage .resizeHandle.sw {
  bottom: -5px;
  left: -5px;
  cursor: nesw-resize;
}

.resizableImage .resizeHandle.se {
  bottom: -5px;
  right: -5px;
  cursor: nwse-resize;
}

.resizableImage.selected {
  outline: 2px solid #4299e1;
  outline-offset: 2px;
}

/* For selected cells in table */
.selectedCell {
  background-color: rgba(66, 153, 225, 0.2) !important;
}

/* For focused tables */
table.focused {
  outline: 2px solid #4299e1;
  outline-offset: 2px;
}

/* For the drag-over state */
.dragOver {
  background-color: #ebf8ff;
  outline: 2px dashed #4299e1;
  outline-offset: -2px;
}

/* Responsive styles */
@media (max-width: 640px) {
  .toolbar {
    padding: 4px;
  }
  
  .toolbarGroup {
    margin-right: 6px;
    padding-right: 6px;
  }
  
  .toolbar button {
    width: 32px;
    height: 32px;
    margin: 0 1px;
  }
  
  .dialogContent {
    padding: 16px;
    width: 320px;
  }
}
