  if (users.length === 0) {
    return null;
  }

  return (
    <div className={cn('flex flex-wrap gap-2', className)}>
      {users.map((user) => (
        <UserTag
          key={user.id}
          user={user}
          onRemove={onRemove ? () => onRemove(user) : undefined}
        />
      ))}
    </div>
  );
};
