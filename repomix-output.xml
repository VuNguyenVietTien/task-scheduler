        </div>
      </header>
      <main className="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        {children}
      </main>
      
      {/* FCM Notification handler will initialize notifications */}
      {user && <FcmNotificationHandler userId={user.id} />}
