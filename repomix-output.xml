.toolbar {
  display: flex;
  background-color: #f8f9fa;
  border: 1px solid #e2e8f0;
  border-bottom: none;
  border-top-left-radius: 0.375rem;
  border-top-right-radius: 0.375rem;
  padding: 8px;
  flex-wrap: wrap;
}

.toolbarGroup {
  display: flex;
  margin-right: 12px;
  border-right: 1px solid #e2e8f0;
  padding-right: 12px;
}

.toolbarGroup:last-child {
  border-right: none;
}

.toolbar button {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: 1px solid transparent;
  border-radius: 4px;
  cursor: pointer;
  color: #4a5568;
  margin: 0 2px;
}

.toolbar button:hover {
  background-color: #edf2f7;
  border-color: #e2e8f0;
}

.toolbar button.active {
  background-color: #e2e8f0;
  border-color: #cbd5e0;
}

.editor {
  border: 1px solid #e2e8f0;
  border-bottom-left-radius: 0.375rem;
  border-bottom-right-radius: 0.375rem;
  min-height: 200px;
  padding: 16px;
  outline: none;
  overflow-y: auto;
}

.editor:focus {
  border-color: #90cdf4;
}

.editor table {
  border-collapse: collapse;
  width: 100%;
  margin: 16px 0;
  border: 2px solid #e2e8f0;
}

.editor table td,
.editor table th {
  border: 2px solid #e2e8f0;
  padding: 8px;
}

.editor table th {
  background-color: #f8f9fa;
  font-weight: 600;
}

.editor img {
  max-width: 100%;
  height: auto;
}

.editor img.left {
  float: left;
  margin: 0 16px 8px 0;
}

.editor img.center {
  display: block;
  margin: 0 auto 8px;
}

.editor img.right {
  float: right;
  margin: 0 0 8px 16px;
}

.editor blockquote {
  border-left: 4px solid #cbd5e0;
  padding-left: 16px;
  margin-left: 0;
  color: #4a5568;
}

.dialog {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  justify-content: center;
  align-items: center;
