            WHERE ($1::uuid IS NULL OR project_id = $1)
            AND ($2::task_status IS NULL OR status = $2)
            AND ($3::uuid IS NULL OR assignee_id = $3)
            AND is_deleted = false
            ORDER BY created_at DESC
            "#,
            project_id,
