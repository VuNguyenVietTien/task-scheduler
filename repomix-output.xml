        </h2>
        <div className="overflow-x-auto">
          <table className="table w-full">
            <thead>
              <tr>
                <th>Tên công việc</th>
                <th>Người thực hiện</th>
                <th>Hạn hoàn thành</th>
                <th>Tiến độ</th>
              </tr>
            </thead>
            <tbody>
              {activeTasks.map(task => (
                <tr key={task.taskId}>
                  <td>{task.title}</td>
                  <td>{task.assignee?.username || 'Chưa giao'}</td>
