                    visibility: row.visibility,
                    tags: serde_json::from_value(row.tags.unwrap_or_default()).unwrap_or_default(),
                    progress: row.progress,
                })
                .collect();
            info!("✅ [API-SUCCESS] GET /projects - Successfully fetched {} projects", response.len());
            HttpResponse::Ok().json(response)
        }
        Err(e) => {
            error!("❌ [API-ERROR] Database error: {}", e);
            HttpResponse::InternalServerError().json(format!("Could not fetch projects: {}", e))
        }
    }
}

async fn get_project(
    pool: web::Data<PgPool>,
