        r#"
        SELECT 
            plan_id as id, 
            project_id, 
            name, 
            description, 
            created_by, 
            created_at, 
            updated_at, 
            is_active,
            plan_data
        FROM plans
        WHERE plan_id = $1
        "#,
        plan_id
    )
    .fetch_optional(db)
    .await?;
    
