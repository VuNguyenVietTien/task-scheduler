                  style={{
                    backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#6366f1'][item.username.charCodeAt(0) % 6]
                  }}
                >
                  {item.username.charAt(0).toUpperCase()}
                </div>
