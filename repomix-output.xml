) -> Result<Option<Notification>, sqlx::Error> {
    sqlx::query_as!(
        Notification,
        r#"
        SELECT id, user_id, task_id, type, title, message, read, created_at, updated_at
        FROM notifications
        WHERE id = $1
        "#,
        notification_id
    )
    .fetch_optional(pool)
    .await
}

