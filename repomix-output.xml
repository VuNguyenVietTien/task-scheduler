        "SELECT * FROM comments WHERE comment_id = $1 AND NOT is_deleted"
    )
    .bind(comment_id)
    .fetch_optional(pool)
    .await?;

    Ok(row.map(|row| Comment {
        comment_id: row.get("comment_id"),
        task_id: row.get("task_id"),
        user_id: row.get("user_id"),
