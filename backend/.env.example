# Runtime environment: development | test | production
APP_ENV=development

# Server binding (canonical names)
# SAFE DEFAULT: when neither SERVER_HOST nor HOST is set the backend binds
# 127.0.0.1 (loopback). Containers/public deploys MUST set the bind explicitly:
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Existing Docker/Compose aliases remain supported when SERVER_* is absent:
# HOST=0.0.0.0
# PORT=8080
# Production container example: SERVER_HOST=0.0.0.0 (behind proxy/tunnel)

# PostgreSQL (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/task_scheduler
# SQLx migrations are idempotent and locked; enable startup execution explicitly.
RUN_MIGRATIONS=false
# Or run manually: cargo run --bin migrate

# Authentication
# Production: both values must be distinct, non-placeholder, and >=32 characters.
JWT_SECRET=development-jwt-secret-change-before-production
AUTH_SECRET=development-auth-secret-change-before-production
JWT_EXPIRY=86400

# Exact credentialed CORS allowlist. FRONTEND_ORIGINS is comma-separated and
# preferred; FRONTEND_URL is the single-origin compatibility/canonical URL.
# Wildcards are rejected. Production origins must use https.
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000

# Optional Redis (currently no required startup dependency)
# REDIS_URL=redis://127.0.0.1:6379

# Optional email delivery
# EMAIL_FROM=Task Scheduler <noreply@example.com>
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=mailer-user
# EMAIL_SMTP_PASS=mailer-password

# File upload settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Logging
RUST_LOG=info
RUST_BACKTRACE=1

# Optional Supabase dual-auth compatibility (server-side only; never commit real values)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-at-runtime
# SUPABASE_JWT_SECRET=replace-at-runtime

# Optional Firebase audience cross-check
# FIREBASE_PROJECT_ID=your-firebase-project-id

# REST auth cookie settings
# Local/same-site compatibility defaults:
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTP_ONLY=false
# PRODUCTION FAIL-FAST (boot error unless ALL of these hold):
#   COOKIE_SECURE=true                        (mandatory, no default)
#   COOKIE_HTTP_ONLY=true                     (mandatory, no default)
#   COOKIE_JS_COMPAT=true                     ONLY as documented replacement for
#     HTTP_ONLY when legacy browser JS must read the auth-token cookie; accepts
#     XSS token-theft risk deliberately. Example production set:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# COOKIE_HTTP_ONLY=true
# SameSite notes: lax is enough for same-site cross-origin (app.example.com ->
# api.example.com). none is for cross-site deploys and forces Secure.
